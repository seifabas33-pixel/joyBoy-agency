rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── who is who ──
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // Built-in office accounts (never removable — they cannot be locked out) …
    function isBuiltInAdmin() {
      return request.auth.token.email.lower() in [
        'seifabas33@gmail.com',
        'seif.abas33@gmail.com',
        'joyboyentertainmentagency@gmail.com',
        'the.z.1417@gmail.com'
      ];
    }
    // … plus anyone an admin added on the admin page (admins/{email}, lower-case id).
    function isAdmin() {
      return signedIn() && (isBuiltInAdmin()
        || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Approved staff (registered, reviewed and accepted by the office). Hotels, plans and sales items are only readable by them and by admins.
    function isApproved() {
      return signedIn() && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'approved';
    }
    function adminOnlyFields() { return ['status', 'adminNotes', 'reviewedBy', 'reviewedAt', 'hotelId']; }
    // Optional image references written by the employee must point at their own files.
    function pathsOk(uid) {
      return (!('photoPath' in request.resource.data) || request.resource.data.photoPath == uid + '/avatar.jpg')
        && (!('idScanPath' in request.resource.data) || request.resource.data.idScanPath == uid + '/id.jpg')
        && (!('photoThumb' in request.resource.data) || (request.resource.data.photoThumb is string && request.resource.data.photoThumb.size() < 40000 && request.resource.data.photoThumb.matches('data:image/.*')))
        && !('photoUrl' in request.resource.data);
    }
    function inviteOk() {
      return exists(/databases/$(database)/documents/settings/registration)
        && request.resource.data.inviteCodeUsed == get(/databases/$(database)/documents/settings/registration).data.inviteCode;
    }

    // Office accounts managed from the admin page. A signed-in user may check their own entry.
    match /admins/{email} {
      allow get: if isAdmin() || (signedIn() && email == request.auth.token.email.lower());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower() && email.matches('[^@]+@[^@]+\\.[^@]+')
        && request.resource.data.addedBy is string;
      allow delete: if isAdmin() && !(email in ['seifabas33@gmail.com', 'seif.abas33@gmail.com', 'joyboyentertainmentagency@gmail.com', 'the.z.1417@gmail.com']);
    }

    // Registration settings (invite code). Employees never read it; the rules compare it.
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }
    // Sales items (names, prices, commission) are readable by signed-in staff so their card can show commission.
    match /settings/sales {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }
    // ── Pay & sales: written by the office only. Staff read their own sales, and their own payslip once it is marked paid. ──
    // Phones of the office accounts, for decisions and tests. Admins only.
    match /officeDevices/{id} {
      allow read, write: if isAdmin();
    }
    // Notifications the office queued; the sheet script sends them and stamps sentAt. Staff never read this.
    match /notify/{id} {
      allow read, write: if isAdmin();
    }
    match /sales/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /payroll/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'paid');
      allow write: if isAdmin();
    }

    // One document per employee, keyed by their Google uid.
    match /employees/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['adminNotes', 'reviewedBy', 'reviewedAt', 'hotelId'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 3
        && request.resource.data.consentAt is string
        && pathsOk(uid)
        && inviteOk();
      allow update: if (isOwner(uid)
          && pathsOk(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminOnlyFields().concat(['email', 'uid', 'inviteCodeUsed', 'consentAt', 'createdAt'])))
        || isAdmin();
      allow delete: if isAdmin();

      // Profile photo and document scan, stored as data URLs (avatar.jpg / id.jpg).
      match /files/{file} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && file in ['avatar.jpg', 'id.jpg']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000
          && request.resource.data.type is string
          && request.resource.data.type.matches('image/.*');
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Devices registered for push notifications. The employee registers their own; the office only reads them to send.
      match /devices/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.token is string && request.resource.data.token.size() < 4096
          && request.resource.data.keys().hasOnly(['token', 'ua', 'updatedAt']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Office notes: admins only. The employee cannot read or list this.
      match /private/{doc} {
        allow read, write: if isAdmin();
      }
    }

    // ── Hotels: where the teams work. Staff read them (for check-in), admins manage them. ──
    match /hotels/{hotelId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }
    // Daily plan: which spot each shift checks in at — plans/{hotelId}_{date}, set by the office.
    match /plans/{id} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // ── Attendance: one document per person, day and shift, id = uid_YYYY-MM-DD_s1 (s1..s4). ──
    // Day marks by the office (sick, vacation, import) live in uid_YYYY-MM-DD and are admin-only.
    // The employee can only create their own shift record for a shift the hotel has, from inside the
    // planned spot for that shift (or the hotel radius when no spot is planned), and only if they are
    // approved and assigned to that hotel. The time is stamped by the server.
    function approvedAt(uid, hotelId) {
      let e = get(/databases/$(database)/documents/employees/$(uid)).data;
      return e.status == 'approved' && e.hotelId == hotelId;
    }
    function insideFence(d) {
      let h = get(/databases/$(database)/documents/hotels/$(d.hotelId)).data;
      let pid = d.hotelId + '_' + d.date;
      let plan = exists(/databases/$(database)/documents/plans/$(pid)) ? get(/databases/$(database)/documents/plans/$(pid)).data : {};
      // the spot planned for this shift today ('' = anywhere at the hotel); the record must name the same spot
      let sk = ('shifts' in plan && d.shift in plan.shifts) ? plan.shifts[d.shift].get('spot', '') : '';
      let t = (sk != '' && 'spots' in h && sk in h.spots) ? h.spots[sk] : h;
      let dx = (d.lng - t.lng) * t.cosLat * 111320.0;
      let dy = (d.lat - t.lat) * 110540.0;
      // A phone indoors reports a fix that is off by 50–100 m: allow the reported accuracy on top of the radius, capped at 100 m.
      let tol = (d.accuracy is number && d.accuracy > 0) ? (d.accuracy < 100.0 ? d.accuracy : 100.0) : 0.0;
      let r = t.radiusM + tol;
      return d.lat is number && d.lng is number && h.active == true
        && (('shifts' in h) ? (d.shift in h.shifts) : (d.shift in ['s1', 's2', 's3']))
        && d.spot == sk
        && dx * dx + dy * dy <= r * r;
    }
    match /attendance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (isOwner(request.resource.data.uid)
        && id == request.auth.uid + '_' + request.resource.data.date + '_' + request.resource.data.shift
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.shift.matches('s[1-4]')
        && request.resource.data.checkInAt == request.time
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'hotelId', 'hotelName', 'date', 'shift', 'shiftName', 'spot', 'spotName', 'checkInAt', 'lat', 'lng', 'accuracy', 'distM'])
        && approvedAt(request.auth.uid, request.resource.data.hotelId)
        && insideFence(request.resource.data));
      // Owner may (a) check out once, or (b) add their real check-in on a day the office already marked (manual mark / grid import) — once, inside the fence.
      allow update: if isAdmin() || (isOwner(resource.data.uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOutAt'])
          && !('checkOutAt' in resource.data)
          && request.resource.data.checkOutAt == request.time)
        || (!('checkInAt' in resource.data) && 'shift' in resource.data
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkInAt', 'lat', 'lng', 'accuracy', 'distM', 'email', 'name', 'hotelName', 'shiftName', 'spot', 'spotName'])
          && request.resource.data.checkInAt == request.time
          && approvedAt(request.auth.uid, request.resource.data.hotelId)
          && insideFence(request.resource.data))));
      allow delete: if isAdmin();
    }

    // ── Requests: "I could not check in" notes, sent from anywhere; the office decides. One per person, day and shift. ──
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isOwner(request.resource.data.uid)
        && id == request.auth.uid + '_' + request.resource.data.date + '_' + request.resource.data.shift
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.shift.matches('s[1-4]')
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 300
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'hotelId', 'hotelName', 'date', 'shift', 'shiftName', 'reason', 'lat', 'lng', 'accuracy', 'distM', 'status', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
