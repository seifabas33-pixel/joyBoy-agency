rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── who is who ──
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // Built-in office accounts (never removable — they cannot be locked out) …
    function isBuiltInAdmin() {
      return request.auth.token.email.lower() in [
        'seifabas33@gmail.com',
        'seif.abas33@gmail.com',
        'joyboyentertainmentagency@gmail.com',
        'the.z.1417@gmail.com'
      ];
    }
    // … plus anyone an admin added on the admin page (admins/{email}, lower-case id).
    function isAdmin() {
      return signedIn() && (isBuiltInAdmin()
        || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function adminOnlyFields() { return ['status', 'adminNotes', 'reviewedBy', 'reviewedAt', 'hotelId']; }
    // Optional image references written by the employee must point at their own files.
    function pathsOk(uid) {
      return (!('photoPath' in request.resource.data) || request.resource.data.photoPath == uid + '/avatar.jpg')
        && (!('idScanPath' in request.resource.data) || request.resource.data.idScanPath == uid + '/id.jpg')
        && (!('photoThumb' in request.resource.data) || (request.resource.data.photoThumb is string && request.resource.data.photoThumb.size() < 40000 && request.resource.data.photoThumb.matches('data:image/.*')))
        && !('photoUrl' in request.resource.data);
    }
    function inviteOk() {
      return exists(/databases/$(database)/documents/settings/registration)
        && request.resource.data.inviteCodeUsed == get(/databases/$(database)/documents/settings/registration).data.inviteCode;
    }

    // Office accounts managed from the admin page. A signed-in user may check their own entry.
    match /admins/{email} {
      allow get: if isAdmin() || (signedIn() && email == request.auth.token.email.lower());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower() && email.matches('[^@]+@[^@]+\\.[^@]+')
        && request.resource.data.addedBy is string;
      allow delete: if isAdmin() && !(email in ['seifabas33@gmail.com', 'seif.abas33@gmail.com', 'joyboyentertainmentagency@gmail.com', 'the.z.1417@gmail.com']);
    }

    // Registration settings (invite code). Employees never read it; the rules compare it.
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // One document per employee, keyed by their Google uid.
    match /employees/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['adminNotes', 'reviewedBy', 'reviewedAt', 'hotelId'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 3
        && request.resource.data.consentAt is string
        && pathsOk(uid)
        && inviteOk();
      allow update: if (isOwner(uid)
          && pathsOk(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminOnlyFields().concat(['email', 'uid', 'inviteCodeUsed', 'consentAt', 'createdAt'])))
        || isAdmin();
      allow delete: if isAdmin();

      // Profile photo and document scan, stored as data URLs (avatar.jpg / id.jpg).
      match /files/{file} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && file in ['avatar.jpg', 'id.jpg']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000
          && request.resource.data.type is string
          && request.resource.data.type.matches('image/.*');
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Office notes: admins only. The employee cannot read or list this.
      match /private/{doc} {
        allow read, write: if isAdmin();
      }
    }

    // ── Hotels: where the teams work. Staff read them (for check-in), admins manage them. ──
    match /hotels/{hotelId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Attendance: one document per person and day, id = uid_YYYY-MM-DD. ──
    // The employee can only create today's record for themselves, from inside the hotel's radius,
    // and only if they are approved and assigned to that hotel. The time is stamped by the server.
    function approvedAt(uid, hotelId) {
      let e = get(/databases/$(database)/documents/employees/$(uid)).data;
      return e.status == 'approved' && e.hotelId == hotelId;
    }
    function insideFence(d) {
      let h = get(/databases/$(database)/documents/hotels/$(d.hotelId)).data;
      let dx = (d.lng - h.lng) * h.cosLat * 111320.0;
      let dy = (d.lat - h.lat) * 110540.0;
      // A phone indoors reports a fix that is off by 50–100 m: allow the reported accuracy on top of the radius, capped at 100 m.
      let tol = (d.accuracy is number && d.accuracy > 0) ? (d.accuracy < 100.0 ? d.accuracy : 100.0) : 0.0;
      let r = h.radiusM + tol;
      return d.lat is number && d.lng is number && h.active == true
        && dx * dx + dy * dy <= r * r;
    }
    match /attendance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (isOwner(request.resource.data.uid)
        && id == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.checkInAt == request.time
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'hotelId', 'hotelName', 'date', 'checkInAt', 'lat', 'lng', 'accuracy', 'distM'])
        && approvedAt(request.auth.uid, request.resource.data.hotelId)
        && insideFence(request.resource.data));
      allow update: if isAdmin() || (isOwner(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOutAt'])
        && !('checkOutAt' in resource.data)
        && request.resource.data.checkOutAt == request.time);
      allow delete: if isAdmin();
    }

    // ── Requests: "I could not check in" notes, sent from anywhere; the office decides. One per person and day. ──
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isOwner(request.resource.data.uid)
        && id == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 300
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'hotelId', 'hotelName', 'date', 'reason', 'lat', 'lng', 'accuracy', 'distM', 'status', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
