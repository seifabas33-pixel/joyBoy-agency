rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() in [
        'seifabas33@gmail.com',
        'joyboyentertainmentagency@gmail.com'
        // , 'moaz@gmail.com'
      ];
    }
    // profiles/{uid}/avatar.jpg and profiles/{uid}/id.jpg
    match /profiles/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
